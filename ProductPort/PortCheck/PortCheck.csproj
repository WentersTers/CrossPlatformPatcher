<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PortCheck</AssemblyName>
    <RootNamespace>PortCheck</RootNamespace>
    <!-- The port file ships C# 7.3 surface; pinning LangVersion here proves
         the constraint at build time. Product-tree integration compiles it
         under the product's toolchain. -->
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ProductCommandMatcher.cs" />
  </ItemGroup>

</Project>
