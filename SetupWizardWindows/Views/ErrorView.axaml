<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SetupWizardWindows.ViewModels"
             x:Class="SetupWizardWindows.Views.ErrorView">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="*, Auto" Margin="40">
    <StackPanel VerticalAlignment="Center" Spacing="20" HorizontalAlignment="Center">
      <Border Background="#E81123"
              CornerRadius="40"
              Width="60"
              Height="60"
              HorizontalAlignment="Center">
        <TextBlock Text="✗"
                   FontSize="36"
                   Foreground="White"
                   TextAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <TextBlock Text="An Error Occurred"
                 FontSize="24"
                 FontWeight="Bold"
                 TextAlignment="Center" />

      <Border BorderBrush="#E81123"
              BorderThickness="1"
              CornerRadius="4"
              Padding="15"
              MaxWidth="450">
        <TextBlock Text="{Binding ErrorMessage, TargetNullValue='An unknown error occurred'}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </Border>
    </StackPanel>

    <Button Grid.Row="1"
            Content="Back to Start"
            Command="{Binding GoToWelcomeCommand}"
            HorizontalAlignment="Center"
            Margin="0,10,0,30"
            Padding="25,12" />
  </Grid>
</UserControl>
