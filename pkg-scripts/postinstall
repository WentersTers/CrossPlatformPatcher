#!/usr/bin/env sh
set -e

INSTALL_ROOT="${3:-/Applications/CrossPlatformPatcher}"
WIZARD="$INSTALL_ROOT/SetupWizard.command"

if [ -f "$WIZARD" ]; then
    chmod +x "$WIZARD" || true
fi

# If the package payload included Vosk model zips, extract the first usable
# model into the installed app models directory so the first run has a model.
VOSK_ZIP_DIR="$INSTALL_ROOT/VoskModels/zips"
MODEL_DIR="$INSTALL_ROOT/models"

if [ -d "$VOSK_ZIP_DIR" ]; then
    # Ensure model dir exists
    mkdir -p "$MODEL_DIR"

    for zip in "$VOSK_ZIP_DIR"/*.zip; do
        [ -e "$zip" ] || continue
        modelname=$(basename "$zip" .zip)
        target="$MODEL_DIR/$modelname"
        if [ -d "$target" ]; then
            # already extracted
            continue
        fi

        mkdir -p "$target"
        if command -v unzip >/dev/null 2>&1; then
            unzip -q "$zip" -d "$target" || {
                # fallback: copy the zip into target if extraction fails
                cp "$zip" "$target/"
            }
        else
            # If unzip not available, copy zip for later extraction
            cp "$zip" "$target/"
        fi

        # Extract only the first model zip found
        break
    done
fi

exit 0