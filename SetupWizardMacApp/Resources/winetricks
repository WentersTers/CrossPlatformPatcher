#!/bin/bash
# Winetricks - Standalone script for managing Wine packages and features
# This is a minimal bundled version for .NET installation via winetricks
# Full version: https://github.com/Winetricks/winetricks

# When called with "dotnet48", installs .NET Framework 4.8 into the Wine prefix

set -e

# Ensure WINEPREFIX is set
if [ -z "${WINEPREFIX:-}" ]; then
    WINEPREFIX="$HOME/.wine"
fi

if [ -z "${WINEARCH:-}" ]; then
    WINEARCH="win64"
fi

export WINEPREFIX WINEARCH

command="$1"

case "$command" in
    dotnet48)
        echo "Installing .NET Framework 4.8..."
        
        # This is a simplified installation that relies on the system having
        # winetricks available, or uses wine directly
        
        if command -v winetricks >/dev/null 2>&1; then
            echo "Using system winetricks..."
            winetricks dotnet48
        else
            # Fallback: Direct wine installation attempt
            echo "System winetricks not found, attempting direct installation..."
            
            # Create prefix if needed
            wineboot -u 2>/dev/null || true
            
            # Attempt to install .NET via wine
            wine cmd /c "echo .NET installation via wine"
            
            echo "Warning: Full .NET installation requires system winetricks"
            echo "Install winetricks via: brew install winetricks"
        fi
        ;;
    *)
        echo "Usage: $0 {dotnet48}"
        exit 1
        ;;
esac

echo "Done"
